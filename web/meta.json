{
  "title": "House Price Estimator",
  "subtitle": "Estimates the sale price of a house in Ames, Iowa from a dozen facts a buyer or agent already knows: size, quality, age, garage and neighborhood.",
  "tags": [
    "Regression",
    "scikit-learn",
    "Ridge",
    "Cross-validation",
    "ONNX"
  ],
  "task": "regression",
  "target_transform": "log1p",
  "output_label": "Estimated sale price",
  "output_format": "currency",
  "result_title": "Estimate",
  "result_note": "Typical error is about 8% of the price. Try raising Overall quality or changing the Neighborhood.",
  "features": [
    {
      "name": "OverallQual",
      "label": "Overall quality",
      "help": "1 = very poor, 10 = excellent",
      "type": "number",
      "min": 1.0,
      "max": 10.0,
      "step": 1,
      "default": 6
    },
    {
      "name": "GrLivArea",
      "label": "Living area (above ground)",
      "help": "sq ft",
      "type": "number",
      "min": 438.0,
      "max": 4476.0,
      "step": 1,
      "default": 1464
    },
    {
      "name": "TotalBsmtSF",
      "label": "Basement area",
      "help": "sq ft, 0 = no basement",
      "type": "number",
      "min": 0.0,
      "max": 3200.0,
      "step": 1,
      "default": 994
    },
    {
      "name": "GarageCars",
      "label": "Garage size",
      "help": "cars",
      "type": "number",
      "min": 0.0,
      "max": 4.0,
      "step": 1,
      "default": 2
    },
    {
      "name": "YearBuilt",
      "label": "Year built",
      "type": "number",
      "min": 1872.0,
      "max": 2010.0,
      "step": 1,
      "default": 1972
